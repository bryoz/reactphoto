---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import GalleryThumbnail from '../../components/gallery-thumbnail/index.jsx';
import Masonry from 'react-masonry-css';
import { buildImageList, getTopLevelDirectories, getThumbnailForDirectory } from '../../lib/media.js';

const imageModules = import.meta.glob('/src/media/**/*.{jpg,jpeg,png,gif,webp}', { eager: true });
const images = buildImageList(imageModules);
const topDirs = getTopLevelDirectories(images);

const collections = await Promise.all(
  topDirs.map(async (dir) => {
    const thumb = getThumbnailForDirectory(images, dir.path);
    let thumbData = null;
    if (thumb) {
      const optimized = await getImage({
        src: thumb.imageImport,
        width: 480,
        height: 480,
        fit: 'cover',
      });
      thumbData = {
        src: optimized.src,
        width: optimized.attributes.width,
        height: optimized.attributes.height,
      };
    }
    return { ...dir, thumb: thumbData };
  })
);
---

<Layout title="Photos">
  {collections.length > 0 ? (
    <div class="grid">
      {collections.map((col) => (
        <div class="collection">
          <a href={`/photos/${col.slug}`} class="collectionLink">
            {col.thumb && (
              <GalleryThumbnail
                src={col.thumb.src}
                width={col.thumb.width}
                height={col.thumb.height}
                name={col.name}
              />
            )}
          </a>
          <h3 class="collectionTitle">
            <a href={`/photos/${col.slug}`} class="collectionTitleLink">
              {col.name}
            </a>
          </h3>
        </div>
      ))}
    </div>
  ) : (
    <p>Please add folders/images to your media directory</p>
  )}
</Layout>

<style lang="scss">
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;

    @media (min-width: 1100px) {
      gap: 30px;
    }
  }

  .collectionTitle {
    text-align: center;
  }

  .collectionTitleLink {
    color: var(--link);
    text-decoration: none;
    font-weight: 600;
    text-transform: uppercase;
  }
</style>
